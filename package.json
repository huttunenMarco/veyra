{
  "name": "veyra",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --parallel --filter server --filter web dev",
    "dev:all": "pnpm --parallel --filter server --filter web --filter camera-agent dev",
    "db:migrate": "pnpm --filter server db:migrate",
    "db:generate": "pnpm --filter server db:generate",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter web test:e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev:db": "docker compose -f docker-compose.dev.yml up -d"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^17.14.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "license": "MIT"
}
