{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts"
  },
  "dependencies": {
    "@veyra/shared": "workspace:*",
    "bullmq": "^5.61.0",
    "drizzle-orm": "^0.44.6",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.1",
    "nodemailer": "^7.0.9",
    "postgres": "^3.4.7",
    "sharp": "^0.34.4",
    "undici": "^7.16.0",
    "zod": "^4.1.12",
    "@veyra/capture": "workspace:*",
    "@fastify/static": "^8.2.0",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.2",
    "drizzle-kit": "^0.31.5",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
