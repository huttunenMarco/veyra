{
  "name": "camera-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Veyra local camera agent: captures frames from LAN cameras and uploads them over outbound HTTPS.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "test-capture": "tsx --env-file-if-exists=.env src/test-capture.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "tsx": "^4.20.6",
    "@veyra/capture": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
