# URL of the Veyra API (the agent only makes outbound requests to this URL)
VEYRA_API_URL=http://localhost:4000
# One-time enrollment code from Inställningar → Kameraagenter. Only needed for the first start.
VEYRA_ENROLLMENT_TOKEN=
# Where the agent stores its credential after enrollment
VEYRA_STATE_FILE=.veyra-agent.json
# Optional allowlist of camera hosts (hostnames, IPs or CIDRs, comma separated).
# Default: only private/LAN addresses (10/8, 172.16/12, 192.168/16, 169.254/16, localhost).
VEYRA_ALLOWED_HOSTS=
FFMPEG_PATH=ffmpeg
CAPTURE_TIMEOUT_MS=15000
# FFmpeg JPEG quality (2 = best, 31 = worst)
JPEG_QSCALE=3
MAX_CONCURRENT_JOBS=2
