# Only needed for development (`pnpm dev`). With Docker, nothing has to be configured:
# open the app and add your OpenAI key under Inställningar → AI.

DATABASE_URL=postgres://veyra:veyra@localhost:5434/veyra
REDIS_URL=redis://localhost:6381

# Optional. Generated into data/secret.key if empty. Never change it once data exists
# (it encrypts camera passwords and integration secrets).
ENCRYPTION_KEY=

# Optional overrides. When set, they win over what is saved in the UI.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# OPENAI_REASONING_EFFORT=low

# NOTIFICATIONS_MODE=simulate   # record notifications without sending
# ALLOW_PRIVATE_NETWORK_TARGETS=false   # block webhooks to LAN addresses
